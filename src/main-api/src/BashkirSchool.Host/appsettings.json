{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Core": ""
  },
  "Jwt": {
    "Issuer": "BashkirSchool.Core",
    "Audience": "BashkirSchool.Clients",
    "SigningKey": ""
  },
  "Bootstrap": {
    "Username": "admin",
    "Password": ""
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Processing": {
    "BackgroundEnabled": true
  },
  "Registration": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Learning": {
    "Kinds": ["translation-text", "missing-word", "sentence-order", "audio-dictation", "audio-translation", "word-match"]
  },
  "Speech": {
    "ModelRevision": "1",
    "SampleRate": 24000,
    "Threads": 2,
    "TimeoutSeconds": 300,
    "Speakers": { "ba": "bak_aigul", "ru": "ru_bak_aigul" }
  },
  "AudioStorage": {
    "Endpoint": "https://s3.bashperevod.ru",
    "Bucket": "school-audio",
    "Region": "garage",
    "AccessKey": "",
    "SecretKey": "",
    "LinkMinutes": 30
  },
  "DataProtection": {
    "KeyDirectory": ""
  }
}
