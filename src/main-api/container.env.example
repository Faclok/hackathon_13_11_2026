# Copy to a private env file outside Git and replace every <...> value.
# These are actual main-api container variables, not root Compose inputs.
# Pass with: docker run --env-file <private-env-file> -p 8080:8080 <image>

# REQUIRED: PostgreSQL reachable FROM THE CONTAINER; localhost is the container itself.
ConnectionStrings__Core=Host=<postgres-host>;Port=5432;Database=<database>;Username=<db-user>;Password=<db-password>
# REQUIRED: persistent random secret, at least 32 UTF-8 bytes.
Jwt__SigningKey=<random-persistent-signing-key>
# REQUIRED on an empty database: first administrator credentials.
Bootstrap__Username=admin
Bootstrap__Password=<at-least-12-chars-with-uppercase-lowercase-digit-and-symbol>

# OPTIONAL: defaults match appsettings.json / the Dockerfile.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Jwt__Issuer=BashkirSchool.Core
Jwt__Audience=BashkirSchool.Clients
Database__InitializeOnStartup=true
Processing__BackgroundEnabled=true
Registration__PermitLimit=10
Registration__WindowSeconds=60
# Silero is downloaded/loaded only for the first uncached synthesis. Mount /app/models persistently.
Speech__PythonExecutable=/opt/silero/bin/python
Speech__ModelPath=/app/models/v5_cis_base.pt
Speech__ModelRevision=1
Speech__SampleRate=24000
Speech__Threads=2
Speech__TimeoutSeconds=300
Speech__Speakers__ba=bak_aigul
Speech__Speakers__ru=ru_bak_aigul
# Required for audio only. Endpoint must be accessible to the browser and main-api.
# Production Garage S3 API endpoint; create the private bucket and grant this key read/write in Garage.
AudioStorage__Endpoint=https://s3.bashperevod.ru
AudioStorage__Bucket=school-audio
AudioStorage__Region=garage
AudioStorage__AccessKey=<garage-access-key>
AudioStorage__SecretKey=<garage-secret-key>
AudioStorage__LinkMinutes=30
AllowedHosts=*
Logging__LogLevel__Default=Information

# Leave empty to persist Data Protection keys in PostgreSQL (recommended).
# A nonempty directory requires a persistent writable volume in the container.
DataProtection__KeyDirectory=
